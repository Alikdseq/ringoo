# Скопируйте в .env.production (НЕ коммитьте) и заполните уникальными секретами.
# Домен: ringoo15.store
# Генерация: python -c "import secrets; print(secrets.token_urlsafe(48))"

DEBUG=False
SECRET_KEY=CHANGE_ME_UNIQUE_48PLUS_CHARS_CRYPTOGRAPHICALLY_RANDOM
# web/backend — Docker DNS; localhost/127.0.0.1 — compose healthcheck на loopback (порты только 127.0.0.1).
ALLOWED_HOSTS=ringoo15.store,www.ringoo15.store,web,backend,localhost,127.0.0.1
DJANGO_ADMIN_URL=staff-portal-change-me
ADMIN_OTP_ENABLED=1
# TRUST_PROXY=1: Django читает X-Forwarded-Proto (Next SSR/proxy + edge).
# Порт 8000 только 127.0.0.1 / Docker-сеть — не публиковать в WAN.
TRUST_PROXY=1
AXES_IPWARE_PROXY_COUNT=1

# Host proxy → containers (не публиковать на 0.0.0.0)
BACKEND_PUBLISH=127.0.0.1:8000
FRONTEND_PUBLISH=127.0.0.1:3000

# PostgreSQL: bootstrap (владелец тома) ≠ app role
DB_NAME=ringoo
POSTGRES_BOOTSTRAP_USER=ringoo_admin
POSTGRES_BOOTSTRAP_PASSWORD=CHANGE_ME_BOOTSTRAP_DB_PASSWORD_16PLUS
# Роль приложения (least privilege) — см. docs/ops/POSTGRES_LEAST_PRIVILEGE.md
DB_USER=ringoo_app
DB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD_16PLUS
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://ringoo_app:CHANGE_ME_APP_DB_PASSWORD_16PLUS@db:5432/ringoo

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_16PLUS
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD_16PLUS@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD_16PLUS@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD_16PLUS@redis:6379/0

CORS_ALLOWED_ORIGINS=https://ringoo15.store,https://www.ringoo15.store
CSRF_TRUSTED_ORIGINS=https://ringoo15.store,https://www.ringoo15.store
FRONTEND_URL=https://ringoo15.store
PUBLIC_API_ORIGIN=https://ringoo15.store

JWT_COOKIE_ENABLED=True
JWT_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True

# Frontend build args (inlined at image build)
NEXT_PUBLIC_SITE_URL=https://ringoo15.store
NEXT_PUBLIC_APP_URL=https://ringoo15.store
NEXT_PUBLIC_API_V1_URL=https://ringoo15.store/api/v1
NEXT_PUBLIC_USE_AUTH_COOKIES=1
NEXT_PUBLIC_ONLINE_PAYMENT_ENABLED=0
NEXT_PUBLIC_RETURNS_ENABLED=0
RETURNS_ENABLED=0
NEXT_PUBLIC_POLICY_VERSION=2026-11-03
POLICY_VERSION=2026-11-03
NEXT_PUBLIC_ORG_INN=151502153141
NEXT_PUBLIC_ORG_OGRN=308151508700014
NEXT_PUBLIC_PRIVACY_EMAIL=info@ringoo15.store
# NEXT_PUBLIC_ORG_OGRN_ISSUED_AT=27.03.2008
# NEXT_PUBLIC_ORG_SFR=1210189435
# NEXT_PUBLIC_ORG_OKVED=47.78
# NEXT_PUBLIC_ORG_OKPO=0156586320

# Почта (заполните SMTP на VPS; from — домен магазина)
DEFAULT_FROM_EMAIL=noreply@ringoo15.store
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# ЮKassa (тест). Секреты только на backend. Держать ENABLED=0 до smoke.
YOOKASSA_ENABLED=0
YOOKASSA_TEST_MODE=1
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_RETURN_URL=https://ringoo15.store/orders/{order_id}/payment/return
YOOKASSA_WEBHOOK_URL=https://ringoo15.store/api/v1/payments/yookassa/webhook/

# Интеграции — выкл. до отдельного согласования
SBER_ECOM_ENABLED=false
# SBER_ECOM_RETURN_URL=https://ringoo15.store/orders/{order_id}/payment/return
# SBER_ECOM_FAIL_URL=https://ringoo15.store/orders/{order_id}/payment/fail
ONE_C_API_ENABLED=false
ONE_C_ORDER_SYNC_ENABLED=false
ONE_C_SYNC_PARTNER_ON_REGISTER=false
# Периодический catalog sync (Celery Beat). Держать 0 до согласования с владельцем 1С.
ONE_C_CATALOG_SYNC_ENABLED=0
ONE_C_CATALOG_SYNC_INTERVAL_SECONDS=3600
ONE_C_CATALOG_STALE_HOURS=24
# Offsite backup S3 — не включать без настроенного бакета и ключей шифрования
BACKUP_OFFSITE_ENABLED=0

# Proxy / TLS (Caddy: docs/ops/caddy.ringoo15.store.caddyfile)
# DNS: A ringoo15.store → VPS_IP ; A www.ringoo15.store → VPS_IP
