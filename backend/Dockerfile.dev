# Dev: docker-compose (web, celery, celery-beat). BuildKit required.
# Без ghcr.io/astral-sh/uv — uv ставится через pip (PyPI). При проблемах сети: RINGOO_USE_PIP_ONLY=1

FROM python:3.11-slim-bookworm

ARG PIP_INDEX_URL=
ARG PIP_TRUSTED_HOST=
ARG RINGOO_USE_PIP_ONLY=0
ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ARG NO_PROXY=

ENV HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    NO_PROXY=${NO_PROXY} \
    http_proxy=${HTTP_PROXY} \
    https_proxy=${HTTPS_PROXY} \
    no_proxy=${NO_PROXY} \
    DEBIAN_FRONTEND=noninteractive \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=0 \
    UV_SYSTEM_PYTHON=1 \
    UV_HTTP_CONNECT_TIMEOUT=120 \
    UV_HTTP_TIMEOUT=300 \
    UV_HTTP_RETRIES=10 \
    UV_CONCURRENT_DOWNLOADS=2 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DJANGO_SETTINGS_MODULE=config.settings.development

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt requirements-dev.txt ./

RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/root/.cache/uv \
    set -e; \
    PIP_INSTALL="pip install --no-cache-dir"; \
    if [ -n "${PIP_INDEX_URL}" ]; then PIP_INSTALL="${PIP_INSTALL} --index-url ${PIP_INDEX_URL}"; fi; \
    if [ -n "${PIP_TRUSTED_HOST}" ]; then PIP_INSTALL="${PIP_INSTALL} --trusted-host ${PIP_TRUSTED_HOST}"; fi; \
    if [ "${RINGOO_USE_PIP_ONLY}" = "1" ]; then \
      ${PIP_INSTALL} -r requirements-dev.txt; \
    else \
      ${PIP_INSTALL} "uv==0.11.2"; \
      UV_OPTS=""; \
      if [ -n "${PIP_INDEX_URL}" ]; then UV_OPTS="${UV_OPTS} --index-url ${PIP_INDEX_URL}"; fi; \
      if [ -n "${PIP_TRUSTED_HOST}" ]; then UV_OPTS="${UV_OPTS} --allow-insecure-host ${PIP_TRUSTED_HOST}"; fi; \
      uv pip install ${UV_OPTS} --requirement requirements-dev.txt; \
    fi

COPY . .

RUN mkdir -p /app/staticfiles /app/media

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/', timeout=5)" || exit 1

CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
