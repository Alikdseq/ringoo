[flake8]
max-line-length = 120
exclude =
    .git,
    __pycache__,
    venv,
    env,
    .venv,
    migrations,
    manage.py,
    settings,
    */migrations/*,
    */venv/*,
    */env/*
# E203: whitespace before ':' (black)
# E266: too many leading '#' for block comment
# E501: line too long (handled by black)
# W503: line break before binary operator
# F401: imported but unused (handled by isort)
# F403: star imports
# F405: name may be undefined
ignore =
    E203,
    E266,
    E501,
    W503,
    F401,
    F403,
    F405
max-complexity = 10
per-file-ignores =
    __init__.py:F401
    */migrations/*:E501
