# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web,backend
# Демо через ngrok: после scripts/ngrok/sync-ngrok-env.ps1 сюда добавятся *.ngrok-free.dev хосты
PUBLIC_API_ORIGIN=http://localhost:8000
# Нестандартный URL админки (только [a-zA-Z0-9_-], без слэшей). По умолчанию admin
# DJANGO_ADMIN_URL=staff-portal

# Database
# Локальный запуск без PostgreSQL: скопируйте .env.example в .env и задайте USE_SQLITE=True
USE_SQLITE=True
# Для PostgreSQL (Docker или установленный сервер):
# USE_SQLITE=
# DB_NAME=ringoo
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/ringoo

# Redis (для Docker: redis:6379; локально без Docker: USE_REDIS=false — кэш в памяти, SMS работает)
REDIS_URL=redis://redis:6379/0
# В Docker при REDIS_PASSWORD в корневом .env задайте URL с паролем, например:
# REDIS_URL=redis://:your_redis_secret@redis:6379/0
# REDIS_PASSWORD=your_redis_secret
USE_REDIS=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Timezone & Language
TIME_ZONE=Europe/Moscow
LANGUAGE_CODE=ru-ru

# Static & Media
STATIC_URL=/static/
MEDIA_URL=/media/
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media

# Admin downloadable backups (DB+media). Archives never include .env secrets.
# BACKUP_STORAGE_ROOT=/app/var/backups
# BACKUP_DOWNLOAD_TTL_HOURS=24
# BACKUP_CREATE_LOCK_TTL_SECONDS=900
# BACKUP_STALE_ALERT_HOURS=48
# Offsite S3-compatible (see docs/ops/OFFSITE_BACKUP_SETUP.md) — never commit real secrets
# BACKUP_OFFSITE_ENABLED=0
# BACKUP_SCHEDULED_ENABLED=0
# BACKUP_S3_ENDPOINT_URL=
# BACKUP_S3_REGION=ru-central1
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_PREFIX=ringoo/backups
# BACKUP_ENCRYPTION_KEY_ID=v1
# BACKUP_ENCRYPTION_KEY=
# BACKUP_ENCRYPTION_KEYS_PREVIOUS=
# External ops notify (optional; see docs/ops/EXTERNAL_MONITORING_SETUP.md)
# OPS_NOTIFY_ENABLED=0
# OPS_TELEGRAM_BOT_TOKEN=
# OPS_TELEGRAM_CHAT_ID=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True

# CSRF (для запросов с фронта с другого порта/домена; development)
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@ringoo.ru
# Куда слать уведомление при оценке менеджера (ТЗ EPIC 2)
MANAGER_RATING_NOTIFY_EMAIL=manager@ringoo.ru
# Email менеджера для заявок «Не нашли товар» (раздел E.3)
MANAGER_EMAIL=manager@ringoo.ru

# Maps API (Yandex Maps)
YANDEX_MAPS_API_KEY=your-yandex-maps-api-key
YANDEX_GEOCODER_API_KEY=

# Таймаут внешних API (сек) — геокодер и др.; чтобы не вешать воркер при их недоступности
EXTERNAL_API_TIMEOUT=10

# Sentry (Error Tracking)
# Получите DSN на https://sentry.io после регистрации
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Security
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Публичные Swagger/ReDoc и /api/schema/ (в production по умолчанию выключено в production.py)
# API_DOCS_PUBLIC=False

# JWT в HttpOnly-куках (дублируют JSON; для SPA см. NEXT_PUBLIC_USE_AUTH_COOKIES на фронте)
# JWT_COOKIE_ENABLED=True
# JWT_COOKIE_SECURE=False
# JWT_COOKIE_ACCESS_NAME=ringoo_access
# JWT_COOKIE_REFRESH_NAME=ringoo_refresh
# issuer/audience в токенах (SimpleJWT); в production задайте уникальные значения
# JWT_ISSUER=ringoo
# JWT_AUDIENCE=ringoo-clients
# Время жизни access-токена в минутах (по умолчанию 30)
# JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30

# django-axes: блокировка после неудачных входов (см. migrate axes)
# AXES_FAILURE_LIMIT=8
# AXES_COOLOFF_HOURS=1
# За reverse-proxy: число доверенных прокси до Django
# AXES_IPWARE_PROXY_COUNT=1

# TOTP для Django admin (1 = включить; нужен migrate). См. docs/DJANGO_ADMIN_OTP.md
# ADMIN_OTP_ENABLED=0

# File Storage (S3 - опционально)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Frontend URL
FRONTEND_URL=http://localhost:3000

# API Settings
API_V1_PREFIX=api/v1

# --- 1С:УТ 11 HTTP (по умолчанию выключено; заказы — после контракта специалиста) ---
# Единая публикация /razrab/hs/ — не смешивать с /ut11_test/ и UUID других баз.
# Хост подтвердить у администратора 1С; секреты только в env сервера (не в Git/логах).
# ONE_C_API_BASE_URL=http://SERVER/razrab/hs
# ONE_C_LOGIN=
# ONE_C_PASSWORD=
# ONE_C_API_TIMEOUT=60
# ONE_C_API_ENABLED=false
# ONE_C_SYNC_PARTNER_ON_REGISTER=false
# ONE_C_ORDER_SYNC_ENABLED=false
# ONE_C_DEFAULT_WAREHOUSE_ID=  # не используется для sync; склад = Store.onec_warehouse_id
# ONE_C_ORDER_SYNC_MAX_ATTEMPTS=5

# --- ЮKassa (основной онлайн-эквайринг). Тест по умолчанию. ---
# Секретный ключ только здесь / в серверном env. Не использовать NEXT_PUBLIC_*.
YOOKASSA_ENABLED=0
YOOKASSA_TEST_MODE=1
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_RETURN_URL=
YOOKASSA_WEBHOOK_URL=
YOOKASSA_TIMEOUT=30
# Витрина (frontend build, не секрет): NEXT_PUBLIC_ONLINE_PAYMENT_ENABLED=0

# --- Сбербанк ecom (резерв). Держать выключенным при активной ЮKassa. ---
# Тест: https://ecomtest.sberbank.ru  |  Бой: https://epay.sberbank.ru (НЕ включать без подтверждения)
# SBER_ECOM_BASE_URL=https://ecomtest.sberbank.ru
# SBER_ECOM_USERNAME=your-merchant-api
# SBER_ECOM_PASSWORD=
# SBER_ECOM_TIMEOUT=30
# SBER_ECOM_ENABLED=false
# Бой epay — только после явного подтверждения (иначе клиент откажет):
# SBER_ECOM_ALLOW_PRODUCTION=false
# Шаблоны возврата (плейсхолдеры {order_id}, {order_number}). Пусто → FRONTEND_URL/orders/.../payment/...
# SBER_ECOM_RETURN_URL=https://shop.example/orders/{order_id}/payment/return
# SBER_ECOM_FAIL_URL=https://shop.example/orders/{order_id}/payment/fail
# Публичный HTTPS callback (ngrok/staging/production).
# В production при SBER_ECOM_ENABLED=true токен ОБЯЗАТЕЛЕН (ImproperlyConfigured без него).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Один и тот же секрет в env и в URL кабинета (?token=...) или заголовок X-Sber-Callback-Token.
# SBER_ECOM_CALLBACK_TOKEN=
# SBER_ECOM_CALLBACK_URL=https://api.example/api/v1/payments/sber/callback/?token=ТОТ_ЖЕ_СЕКРЕТ
# Явно требовать токен даже при DEBUG (пусто = auto: True если DEBUG=False):
# SBER_ECOM_CALLBACK_TOKEN_REQUIRED=true
# ONLINE_PAYMENT_TIMEOUT_MINUTES=20
# Оплата после отмены заказа: manual (сверка) | revive | reverse
# LATE_ONLINE_PAYMENT_POLICY=manual
