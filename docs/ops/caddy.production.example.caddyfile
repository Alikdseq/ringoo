# Пример Caddy перед Docker (TLS автоматически).
# Подставьте shop.example.com. Proxy только с доверенного хоста к контейнерам.

shop.example.com {
	encode gzip

	# Frontend (Next.js)
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

# Если API на поддомене:
# api.shop.example.com {
# 	reverse_proxy 127.0.0.1:8000
# }

# Важно: не пробрасывайте 5432/6379 на firewall.
# Django: TRUST_PROXY=1, SECURE_PROXY_SSL_HEADER уже включается при TRUST_PROXY.
# CSRF_TRUSTED_ORIGINS / CORS_ALLOWED_ORIGINS = https://shop.example.com
