# Пример Caddy перед Docker (TLS автоматически).
# Для Ringoo production используйте этот файл или docs/ops/caddy.ringoo15.store.caddyfile
# Proxy только с доверенного хоста к контейнерам на 127.0.0.1.

www.ringoo15.store {
	redir https://ringoo15.store{uri} permanent
}

ringoo15.store {
	encode gzip

	# Frontend (Next.js; проксирует /api/v1 на Django внутри Docker-сети)
	handle {
		reverse_proxy 127.0.0.1:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}

# Если API на поддомене (обычно не нужно при same-origin proxy):
# api.ringoo15.store {
# 	reverse_proxy 127.0.0.1:8000
# }

# Важно: не пробрасывайте 5432/6379 на firewall.
# Django: TRUST_PROXY=1, SECURE_PROXY_SSL_HEADER включается при TRUST_PROXY.
# CSRF_TRUSTED_ORIGINS / CORS_ALLOWED_ORIGINS = https://ringoo15.store,https://www.ringoo15.store
