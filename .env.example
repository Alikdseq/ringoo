# Ringoo — переменные для docker compose (скопируйте в .env в корне репозитория)

# Порты на хосте
BACKEND_PORT=8000
FRONTEND_PORT=3000
DB_PORT=5436
REDIS_PORT=6380

# PostgreSQL
DB_NAME=ringoo
DB_USER=postgres
DB_PASSWORD=postgres

# Redis (опционально пароль)
# REDIS_URL=redis://:secret@redis:6379/0
# REDIS_PASSWORD=secret

# PyPI при сборке backend (опционально)
# PIP_INDEX_URL=
# PIP_TRUSTED_HOST=
# Только pip без uv (если TLS к PyPI через uv): RINGOO_USE_PIP_ONLY=1

# Production frontend build (docker-compose.prod.yml)
# NEXT_PUBLIC_API_V1_URL=https://api.ringoo.ru/api/v1
# NEXT_PUBLIC_SITE_URL=https://ringoo.ru

# Vercel (задаются в Project → Settings → Environment Variables, не в git):
# SECRET_KEY= длинный случайный ключ, минимум 48 символов
# DATABASE_URL= postgres URL из Vercel Postgres / Neon
# На Vercel фронт ходит на /api/v1 того же домена. NEXT_PUBLIC_API_V1_URL можно не задавать.

# --- Интеграции (секреты только в env / CI secrets, не в git) ---
# Полный список: backend/.env.example
# 1С: ONE_C_API_BASE_URL (.../razrab/hs), ONE_C_LOGIN, ONE_C_PASSWORD,
# ONE_C_API_ENABLED, ONE_C_ORDER_SYNC_ENABLED, ONE_C_DEFAULT_WAREHOUSE_ID
#
# ЮKassa (тест) — основной онлайн-эквайринг. Секреты только в локальном .env / CI.
YOOKASSA_ENABLED=0
YOOKASSA_TEST_MODE=1
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_RETURN_URL=
YOOKASSA_WEBHOOK_URL=
NEXT_PUBLIC_ONLINE_PAYMENT_ENABLED=0
SBER_ECOM_ENABLED=false
#
# Сбер (резерв): SBER_ECOM_BASE_URL=https://ecomtest.sberbank.ru
#   SBER_ECOM_USERNAME, SBER_ECOM_PASSWORD, SBER_ECOM_ENABLED
#   SBER_ECOM_CALLBACK_URL, SBER_ECOM_RETURN_URL, SBER_ECOM_FAIL_URL
#   ONLINE_PAYMENT_TIMEOUT_MINUTES, LATE_ONLINE_PAYMENT_POLICY
# Бой epay.sberbank.ru — только после явного подтверждения.
# Документация: docs/payments/YOOKASSA_INTEGRATION.md
#
# Offsite backup (S3-compatible): placeholders в backend/.env.example
# и инструкция docs/ops/OFFSITE_BACKUP_SETUP.md — секреты только в локальном .env.
