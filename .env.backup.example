# Copy to .env.backup (do not commit).
# Used by: scripts/backup-db.sh, backup-db-encrypted.sh, backup-set.sh, restore-db.sh

DB_CONTAINER=ringoo_db
DB_NAME=ringoo
# Prefer bootstrap/backup role with SELECT; avoid unnecessary SUPERUSER.
# Must match restore-db.sh default (ringoo_admin), not "postgres".
DB_USER=ringoo_admin

BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
MEDIA_VOLUME=ringoo_media_volume
# age recipient (public): age1...  — private key хранить ВНЕ VPS и НЕ рядом с архивами
AGE_RECIPIENT=age1REPLACE_ME

# Recommended orchestration (DB+Media+checksum+optional age):
#   ./scripts/backup-set.sh
# Offsite S3: Django BACKUP_OFFSITE_* (docs/ops/OFFSITE_BACKUP_SETUP.md) — NOT VERIFIED until credentials exist.
# Optional offsite hint (manual)
# OFFSITE_HINT=s3://your-bucket/ringoo-backups/
