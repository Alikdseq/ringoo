# Ringoo frontend — пример переменных (без секретов).
# Скопируйте в .env.local и подставьте значения.

# API (обязательно HTTPS на staging/production)
NEXT_PUBLIC_API_V1_URL=https://api.ringoo.ru/api/v1

# Канонический URL сайта (SEO, sitemap)
NEXT_PUBLIC_SITE_URL=https://ringoo.ru

# Авторизация: на staging/production всегда 1 (HttpOnly JWT-куки)
NEXT_PUBLIC_USE_AUTH_COOKIES=1

# Имена JWT-кук (должны совпадать с backend JWT_COOKIE_*)
NEXT_PUBLIC_JWT_COOKIE_ACCESS_NAME=ringoo_access
NEXT_PUBLIC_JWT_COOKIE_REFRESH_NAME=ringoo_refresh

# Яндекс.Карты — публичные ключи с ограничением по Referer в консоли
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
NEXT_PUBLIC_YANDEX_SUGGEST_API_KEY=

# Sentry (публичный DSN)
NEXT_PUBLIC_SENTRY_DSN=

# Юридические реквизиты и версия политики ПДн (152-ФЗ)
NEXT_PUBLIC_POLICY_VERSION=2026-05-16
NEXT_PUBLIC_ORG_INN=
NEXT_PUBLIC_ORG_OGRN=
NEXT_PUBLIC_ORG_KPP=
NEXT_PUBLIC_PRIVACY_EMAIL=info@ringoo.ru

# Яндекс.Метрика (загружается только после согласия в баннере)
NEXT_PUBLIC_YANDEX_METRICA_ID=
