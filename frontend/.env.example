# Ringoo frontend — пример переменных для https://ringoo15.store
# Скопируйте в .env.local для локальной разработки (там обычно localhost).

# API (на production — same-origin)
NEXT_PUBLIC_API_V1_URL=https://ringoo15.store/api/v1

# Канонический URL сайта (SEO, sitemap, cookies)
NEXT_PUBLIC_SITE_URL=https://ringoo15.store
NEXT_PUBLIC_APP_URL=https://ringoo15.store

# Авторизация: на staging/production всегда 1 (HttpOnly JWT-куки)
NEXT_PUBLIC_USE_AUTH_COOKIES=1

# Имена JWT-кук (должны совпадать с backend JWT_COOKIE_*)
NEXT_PUBLIC_JWT_COOKIE_ACCESS_NAME=ringoo_access
NEXT_PUBLIC_JWT_COOKIE_REFRESH_NAME=ringoo_refresh

# Яндекс.Карты — публичные ключи с ограничением по Referer (ringoo15.store) в консоли
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
NEXT_PUBLIC_YANDEX_SUGGEST_API_KEY=

# Sentry (публичный DSN)
NEXT_PUBLIC_SENTRY_DSN=

# Юридические реквизиты и версия политики ПДн (152-ФЗ)
NEXT_PUBLIC_POLICY_VERSION=2026-11-03
NEXT_PUBLIC_ORG_INN=151502153141
NEXT_PUBLIC_ORG_OGRN=308151508700014
NEXT_PUBLIC_ORG_KPP=
NEXT_PUBLIC_PRIVACY_EMAIL=info@ringoo15.store

# Флаги витрины (на первом деплое — выкл.)
NEXT_PUBLIC_ONLINE_PAYMENT_ENABLED=0
NEXT_PUBLIC_RETURNS_ENABLED=0

# Яндекс.Метрика (загружается только после согласия в баннере)
NEXT_PUBLIC_YANDEX_METRICA_ID=
