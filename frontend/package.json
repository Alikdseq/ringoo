{
  "name": "ringoo-frontend",
  "version": "0.1.0",
  "description": "Frontend интернет-магазина Ringoo (Next.js + TypeScript + Tailwind)",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "magazins:manifest": "node scripts/generate-magazins-manifest.mjs",
    "menegers:manifest": "node scripts/generate-menegers-manifest.mjs",
    "dev:clean": "node scripts/clean-next.mjs && next dev",
    "dev:webpack": "next dev --webpack",
    "dev:ngrok": "next dev --webpack --no-server-fast-refresh",
    "clean:next": "node scripts/clean-next.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md}\"",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "analyze": "cross-env ANALYZE=true next build",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@sentry/nextjs": "^10.46.0",
    "@tanstack/react-query": "^5.90.20",
    "@types/three": "^0.182.0",
    "axios": "^1.13.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.563.0",
    "next": "16.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-intersection-observer": "^10.0.2",
    "swiper": "^12.1.0",
    "three": "^0.183.0",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.1",
    "@tailwindcss/postcss": "^4",
    "cross-env": "^7.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.1",
    "eslint-plugin-security": "^4.0.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.0",
    "vitest": "^4.0.18"
  }
}
