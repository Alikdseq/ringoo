# Переменные для сервиса frontend в docker compose (скопируйте в .env.docker).
# NEXT_PUBLIC_* попадают в браузер — URL API с точки зрения хоста (localhost).

NEXT_PUBLIC_API_V1_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_USE_AUTH_COOKIES=1

# SSR и image optimizer внутри сети compose (не менять для dev compose)
API_INTERNAL_V1_URL=http://web:8000/api/v1

# Для next/image: медиа с backend-контейнера
IMAGES_ALLOW_LOCAL_IP=true
